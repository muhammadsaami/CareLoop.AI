# ──────────────────────────────────────────────────────────────────────────────
# CareLoop AI — .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# Secrets — NEVER commit these
.env
*.env
!.env.example

# Python virtual environment
.venv/
venv/
env/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.egg-info/
dist/
build/

# Alembic generated (keep versions/ tracked)
# alembic/versions/*.pyc

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Uploaded patient documents (Phase 2) — never commit real discharge files.
# Only the storage tree is ignored; individual file types are NOT blanket
# ignored, so legitimate assets (sample PDFs, images) stay visible to git.
storage/

# ChromaDB vector store (Phase 3) — contains verbatim patient document text
# and must never be committed.  Mirrors CHROMA_PERSIST_DIRECTORY.
chroma_data/
chroma/

# Local semantic embedding model (Phase 3) — ~127 MB of ONNX weights fetched
# once via `python -m app.rag.embeddings.fetch_model`.  Mirrors
# RAG_SEMANTIC_MODEL_DIR.  Weights are a build artifact, not source.
#
# ROOTED (/models/), not bare (models/).  A bare pattern matches at ANY depth,
# so it also swallowed `app/models/` - the ORM package - which silently hid
# four source files from every commit: notification.py and reminder.py (Phase
# 5, already missing from HEAD), escalation.py (Phase 6), and user.py (the
# authentication principal and patient_access grant).  The leading slash anchors
# this to backend/models/ and nowhere else.
#
# The slash must not be dropped: `git status` is the only place this failure is
# visible, and a commit would omit the files without complaint.
/models/

# Distribution / packaging
*.egg
*.whl
