APP_NAME=CareLoop AI
ENVIRONMENT=development

# PostgreSQL — no value here on purpose: an example file must not ship a
# usable credential. Copy this line into your local backend/.env and fill it in.
DATABASE_URL=

# Secret key for JWT (future phase) — generate with: openssl rand -hex 32
SECRET_KEY=

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Test database — must be a SEPARATE database from DATABASE_URL
TEST_DATABASE_URL=

# ──────────────────────────────────────────────────────────────────────────────
# Phase 2 — Discharge document ingestion, OCR, and structured extraction
# ──────────────────────────────────────────────────────────────────────────────

# Where uploaded documents are stored, relative to the backend/ directory.
# Uploads are NEVER written inside the app/ Python package.
DOCUMENT_STORAGE_PATH=storage/discharge_documents

# Upload limits
MAX_UPLOAD_SIZE_MB=10
MAX_DOCUMENT_PAGES=30

# Tesseract OCR. Leave TESSERACT_CMD blank to use the system PATH.
# Windows example (no quotes, adjust to your install):
#   TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGE=eng

# Structured extraction provider: groq | gemini
# Only the SELECTED provider needs an API key.
LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys
# Leave GROQ_MODEL blank to use the default in app/core/config.py.
# llama-3.3-70b-versatile was decommissioned by Groq and returns 404.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# Seconds to wait for an LLM extraction request
LLM_TIMEOUT_SECONDS=60

# ──────────────────────────────────────────────────────────────────────────────
# Phase 3 — RAG retrieval (ChromaDB)
# All values below are optional; the defaults in app/core/config.py work as-is.
# ──────────────────────────────────────────────────────────────────────────────

# Where the ChromaDB index is persisted. Relative paths resolve against
# backend/.  This directory holds verbatim patient document text: it is
# git-ignored and must never be committed or backed up to shared storage.
CHROMA_PERSIST_DIRECTORY=chroma_data

# Chroma collection name. 3-63 chars, letters/digits/underscore/hyphen.
# Isolation is enforced by mandatory patient_id + discharge_document_id
# metadata filters on every read and delete, NOT by this name.
CHROMA_COLLECTION_NAME=careloop_documents

# Chunking. Chunks never span a page, so source_page is always exact.
# RAG_CHUNK_OVERLAP must be at most half of RAG_CHUNK_SIZE.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MIN_CHUNK_CHARS=20

# Embedding provider. Two ship:
#
#   semantic (default) - a real sentence-embedding model run LOCALLY through
#       ONNX Runtime. Matches meaning, not wording: "blood thinner" finds a
#       document that only says "warfarin ... to thin your blood". Nothing is
#       sent to any third party; there is no API key for this provider.
#   hashing            - a lexical bag-of-words fallback needing no model
#       files at all. Use it for an air-gapped install, or to run without
#       fetching weights. It matches shared WORDS only, so it will not find
#       "paracetamol" from "water tablet".
RAG_EMBEDDING_PROVIDER=semantic

# ── Semantic model (ignored when RAG_EMBEDDING_PROVIDER=hashing) ───────────
# Default is a 33M-parameter, 384-dimension sentence embedder (~127 MB of
# ONNX weights). Chosen because it is genuinely good at retrieval while
# running on CPU via onnxruntime - which chromadb already depends on - so no
# torch and no heavyweight runtime is introduced.
#
# Fetch the weights ONCE during deployment (operator-initiated, not automatic):
#   python -m app.rag.embeddings.fetch_model
# Inference never touches the network. Set ALLOW_DOWNLOAD=false afterwards, or
# on an air-gapped host where the files are copied in manually.
RAG_SEMANTIC_MODEL_NAME=BAAI/bge-small-en-v1.5
RAG_SEMANTIC_MODEL_DIR=models/embeddings/bge-small-en-v1.5
RAG_SEMANTIC_ALLOW_DOWNLOAD=true

# Revision of the model to fetch, and part of the index fingerprint.
# "main" is a MOVING TARGET: re-fetching it after upstream updates can yield
# different weights, which changes every vector. Pin an immutable commit SHA
# for byte-reproducible rebuilds. Changing this requires re-indexing.
RAG_SEMANTIC_MODEL_REVISION=main

# BGE models are trained with an instruction prefix on the QUERY side only.
# Applying it to documents degrades their vectors, so this is applied
# internally and is not a knob you should normally change.
#
# QUOTED ON PURPOSE: the model was trained with a trailing space after the
# colon, and the quotes stop an editor or whitespace-trimming hook from
# silently deleting it. The quotes are not part of the value.
RAG_SEMANTIC_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "

# 512 is the model's trained maximum; a larger value is silently ignored by
# the ONNX graph.
RAG_SEMANTIC_MAX_TOKENS=512

# Inference threads. 0 lets onnxruntime choose.
RAG_SEMANTIC_NUM_THREADS=0

# Dimensions for the 'hashing' provider only. The semantic model fixes its own
# width, so this is ignored for it and the two providers can coexist.
RAG_EMBEDDING_DIMENSIONS=384

# How many independent hash projections each token is spread across (>= 1).
# One projection makes any two tokens that collide in a single bucket score
# as identical, which silently conflated unrelated clinical terms. Two
# projections reduce that: a term vs. itself scores 0.22 instead of 0.0.
# Raise it if you swap in a wider-vocabulary model; lower it trades collision
# risk for a denser vector.
RAG_EMBEDDING_PROJECTIONS=2

# Retrieval limits. top_k is clamped to RAG_MAX_TOP_K server-side.
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=25

# Similarity floor (0.0-1.0). A vector store always returns its N nearest
# neighbours, so without a floor a query the document never mentions would
# still come back with its least-unrelated passage. Chunks below this score
# are dropped and the response reports zero matches.
#
# LEAVE THIS UNSET to use the selected provider's calibrated default, which is
# strongly recommended: the number is a property of the MODEL, not of this
# service. A dense encoder compresses cosine similarity into roughly
# 0.45-0.75 and never approaches 0 or 1, so its floor is 0.60, while the
# lexical provider spans a far wider range and uses 0.10. Applying one model's
# floor to the other either floods results with off-topic chunks or discards
# every genuine match.
#
# Set a number ONLY to tune against your own corpus.
# RAG_MIN_SCORE=

# ──────────────────────────────────────────────────────────────────────────────
# Phase 4 — LangGraph grounded-answer agent
# ──────────────────────────────────────────────────────────────────────────────

# Every setting below has a working default; the agent is safe with nothing
# configured. Leave them unset unless you are tuning against your own corpus.
#
# Note what is NOT here: there is no agent-specific API key. The agent reuses
# the Phase 2 provider you already selected (LLM_PROVIDER + that provider's
# key), so there is nothing extra to fill in and no second provider to
# configure.

# Maximum chunks placed in one prompt. Bounds the token cost of a single
# request. Retrieval already caps chunk size and count, so this is a second
# ceiling rather than the only one.
# AGENT_MAX_TOP_K=8

# Hard cap on characters of source text sent to the provider.
# AGENT_MAX_PROMPT_CHARS=12000

# Share of a cited chunk's distinctive vocabulary that must appear in the
# answer for grounding to be considered established (0.0 - 1.0).
#
# RAISE THIS to be stricter about paraphrase, LOWER it to tolerate more
# summarising. It is a lexical GUARD, not entailment: it confirms the answer
# reuses the sources' vocabulary, NOT that the sources actually assert the
# answer's claim. It cannot and does not certify medical correctness.
# AGENT_MIN_OVERLAP_RATIO=0.30

# Log the compiled graph topology (node and edge names only, never state).
# AGENT_LOG_GRAPH_TOPOLOGY=false

# ──────────────────────────────────────────────────────────────────────────────
# Phase 5 — Scheduling and notifications (Celery + Redis)
# ──────────────────────────────────────────────────────────────────────────────
#
# SAFETY, not convenience, is the reason several of these matter more than they
# look. Each note says what breaks if you get it wrong.

# Redis: Celery broker and result backend.  The API never connects to it, so
# the API can boot and serve while Redis is down - reminders simply stop, and
# resume from the database when it returns.
REDIS_URL=redis://localhost:6379/0

# Override the broker/backend only to split them (e.g. a dedicated result DB).
# Blank means "use REDIS_URL", which is the right default.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Queue name.  Namespaced so a Phase 5 worker never competes for messages with
# other queues on the same broker.  Change it and you must restart every worker.
CELERY_QUEUE=careloop.notifications

# Delivery transport: console | whatsapp
#
# 'console' is the default and is deliberate: it records the attempt in the
# database and sends nothing.  A deployment that has not chosen a transport
# cannot accidentally message a patient.
NOTIFICATION_PROVIDER=console

# WhatsApp Cloud API — https://developers.facebook.com
# BOTH are required, or the provider raises a configuration error at send time
# rather than at construction, so a half-configured deployment degrades one
# delivery instead of preventing the worker from booting.
#
# A missing token makes the selected provider fail; it never silently falls
# back to console, so a misconfiguration is visible rather than invisible.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Per-request timeout to the provider.  Kept below the Celery soft time limit
# (45s) on purpose: the worker must give up before Celery kills it, or the
# message is left claimed and only recovers via the 5-minute reconcile task.
NOTIFICATION_TIMEOUT_SECONDS=20

# Retry budget for a transient failure.  Retries use exponential backoff, so
# attempt N waits roughly BASE * 2^(N-1) seconds, capped at MAX.
#
# 3 attempts over roughly 3 minutes is chosen so a brief provider outage is
# ridden out while a genuinely broken recipient fails within a few minutes
# rather than lingering as 'failed' all day.  Raise MAX_ATTEMPTS only alongside
# a matching MAX_SECONDS, or attempts will stop before the backoff grows.
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_MAX_SECONDS=3600

# How far ahead of its occurrence a notification is materialised.  The dispatch
# tick runs every 60s, so 300s gives four chances to create a notification
# before it is due.
#
# This is also the bound on recovery: an occurrence missed by MORE than this
# (a long outage) is deliberately SKIPPED, not sent late, because a medication
# reminder hours overdue risks a double dose.  Widening it trades that safety
# margin for coverage of longer outages.
SCHEDULER_LOOKAHEAD_SECONDS=300

# Rows processed per tick.  A tick that cannot finish its batch simply runs
# again on the next minute, so raising this is only safe while a single batch
# still completes inside the 60s soft time limit.
SCHEDULER_BATCH_SIZE=100

# ──────────────────────────────────────────────────────────────────────────────
# Future phases — leave blank for now, do NOT fill in values yet
# ──────────────────────────────────────────────────────────────────────────────
