# Base URL of the CareLoop AI backend API.
# In development you can leave this unset: vite.config.ts proxies /api to
# http://127.0.0.1:8000 so the browser stays same-origin.
# For production, set it to the deployed backend, e.g.
#   VITE_API_BASE_URL=https://careloop-api.example.com
# Leave the value WITHOUT a trailing slash. The app appends /api/v1/... itself.
VITE_API_BASE_URL=

# Maximum upload size in bytes the UI will accept before the browser rejects a
# file client-side. The backend enforces its own limit; this avoids a pointless
# upload. Must match the backend's configured maximum.
VITE_MAX_UPLOAD_BYTES=20971520
